---
import Layout from '@/src/layouts/Layout.astro'
import RequestsDashboard from '@/components/requests-dashboard'

const sessionCookie = Astro.cookies.get('session_token');
let session = null;
if (sessionCookie) {
  try {
    session = JSON.parse(sessionCookie.value);
  } catch (e) {}
}

if (!session || session.role !== 'admin') {
  return Astro.redirect('/workspace-mc361/login')
}

const formatName = (email: string) => {
  if (!email) return 'Admin';
  const parts = email.split('@')[0].split('.');
  if (parts.length >= 3) {
    const nombre = parts[0].charAt(0).toUpperCase() + parts[0].slice(1);
    const apellido = parts[1].charAt(0).toUpperCase() + parts[1].slice(1);
    const inicial = parts[2].charAt(0).toUpperCase();
    return `${nombre} ${apellido} ${inicial}.`;
  }
  return email.split('@')[0];
}
---

<Layout title="Solicitudes | Panel Admin">
  <div class="min-h-screen bg-[#f8f5f4] flex flex-col">
    <header class="bg-white border-b border-[#eadada] shadow-[0_4px_20px_-15px_rgba(0,0,0,0.1)] shrink-0 z-10 relative">
      <div class="max-w-[1200px] mx-auto flex justify-between items-center px-6 h-16">
        <div class="flex items-center gap-6">
          <div class="flex items-center gap-3 border-r border-[#eadada] pr-6">
            <svg class="w-5 h-5 text-[#8B0000]" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round">
              <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/>
            </svg>
            <span class="font-serif text-lg font-bold text-[#3b2022] tracking-wide">
              Panel Admin
            </span>
          </div>
          <nav class="flex gap-1">
            <a href="/workspace-mc361/content/chapters" class="px-3 py-1.5 text-sm font-semibold text-[#8b6d6d] hover:text-[#8B0000] hover:bg-[#f1dddd] rounded-md transition-colors">
              Volver al Contenido
            </a>
            <a href="/workspace-mc361/management/collaborators" class="px-3 py-1.5 text-sm font-semibold text-[#8b6d6d] hover:text-[#8B0000] hover:bg-[#f1dddd] rounded-md transition-colors">
              Usuarios
            </a>
            <a href="/workspace-mc361/management/requests" class="px-3 py-1.5 text-sm font-semibold text-[#8B0000] bg-[#f8eaea] rounded-md transition-colors">
              Solicitudes
            </a>
          </nav>
        </div>
        
        <div class="flex items-center gap-3">
          <span class="text-sm font-medium text-[#5c4343]">
            {formatName(session.email)}
          </span>
          <button id="logout-btn" title="Cerrar sesión" class="text-[#a08484] hover:text-[#8B0000] transition-colors flex items-center justify-center bg-[#fdfafa] hover:bg-[#f8eaea] w-8 h-8 rounded-full border border-transparent hover:border-[#f1dddd]">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" y1="12" x2="9" y2="12"></line></svg>
          </button>
        </div>
      </div>
    </header>

    <main class="flex-1 min-h-0">
      <RequestsDashboard client:only="react" />
    </main>
  </div>
</Layout>

<script>
  import { auth } from '@/lib/firebase'
  
  const logoutBtn = document.getElementById('logout-btn');
  if (logoutBtn) {
    logoutBtn.addEventListener('click', async () => {
      await auth.signOut()
      document.cookie = "session_token=; path=/; max-age=0";
      window.location.href = '/workspace-mc361/login'
    })
  }
</script>
